# Copy this file to .env and fill in only what you want live. Anything left empty runs in mock mode.
# Never commit .env.

# GitHub fine-grained token (public repositories, read-only). Live research.
GITHUB_TOKEN=

# Google OAuth (Drive, Calendar, Gmail). One Web application client plus a refresh token from the OAuth Playground.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Drive folder to watch for new clips (the ID at the end of the folder URL). Empty = top level of My Drive only.
DRIVE_FOLDER_ID=
# Set to 1 to let approved emails actually send. Empty = approved emails become Gmail drafts.
GMAIL_ALLOW_SEND=

# Slack bot token (starts with xoxb-) and the channel ID (starts with C) the bot was invited to.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# OpenAI key for Whisper captions (starts with sk-proj- or sk-). Needs paid credit. Empty = local whisper CLI or mock transcripts.
OPENAI_API_KEY=
# Model for the local whisper CLI (tiny, base, small, medium, large). Default: base.
WHISPER_MODEL=

# Higgsfield AI video/images. Get a key at https://open.higgsfield.ai/api-keys and paste the complete key as-is
# (the whole copied credential, e.g. KEY_ID:KEY_SECRET; do not add "Key " in front). Empty = mock placeholders.
HF_API_KEY=
# REST base URL. Default: https://api.higgsfield.ai
HF_API_BASE_URL=
# Hard daily spending cap in USD for approved generations (estimated). Default: 10.
HIGGSFIELD_MAX_USD_PER_DAY=
# Estimate used for models without a listed price, in USD per second of output. Default: 0.40.
HIGGSFIELD_UNKNOWN_USD_PER_SEC=

# Thumbnail renderer. Empty = local Pillow script. "canva" is a placeholder hook, not wired yet.
THUMBNAIL_PROVIDER=
# Python used for thumbnails. Default: python3.
PYTHON=

# Path to the Claude Code CLI. Default: claude.
CLAUDE_BIN=
# SQLite database for tasks, approvals and events. Default: data/office.db.
OFFICE_DB=

# Dashboard address. Default: 127.0.0.1 and 4000. Keep HOST local: the dashboard can approve real actions.
PORT=
HOST=

# Shop and analytics are mock-only for now; these keys are reserved for future adapters.
SHOP_API_KEY=
ANALYTICS_API_KEY=
